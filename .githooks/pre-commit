#!/usr/bin/env bash
# 1) Reject Cursor / GitHub Copilot as commit author or committer.
# 2) Bump package.json patch before each commit so the bump lands in that commit.
# Skip version bump: SKIP_VERSION_BUMP=1, merge commits, or missing package.json.
# Skip identity check: SKIP_AGENT_ATTRIBUTION_CHECK=1.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Run before the version bump so a blocked identity never leaves a dirty bump.
if [[ -f scripts/agent-commit-attribution.mjs ]]; then
  node scripts/agent-commit-attribution.mjs check-identity
fi

if [[ -n "${SKIP_VERSION_BUMP:-}" ]]; then
  exit 0
fi

git_dir="$(git rev-parse --git-dir)"
if [[ -f "${git_dir}/MERGE_HEAD" ]]; then
  exit 0
fi

if [[ ! -f package.json ]]; then
  exit 0
fi

prev="$(node -p "JSON.parse(require('fs').readFileSync('package.json','utf8')).version")"
npm version patch --no-git-tag-version >/dev/null
next="$(node -p "JSON.parse(require('fs').readFileSync('package.json','utf8')).version")"

git add package.json
if [[ -f package-lock.json ]]; then
  git add package-lock.json
fi

echo "kusa: version ${prev} → ${next}"
