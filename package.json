{
  "name": "kusa",
  "version": "0.1.16",
  "description": "Kusă — harness-agnostic session counters, live dashboard, and optional MCP server for Copilot, Cursor, and VS Code Local",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "preferGlobal": true,
  "bin": {
    "kusa": "./src/shared/cli/kusa.mjs"
  },
  "exports": {
    ".": "./src/features/monitor/lib.mjs",
    "./lib": "./src/features/monitor/lib.mjs",
    "./pkg": "./src/shared/lib/pkg.mjs",
    "./hook": "./src/features/monitor/hook.mjs",
    "./open": "./src/app/console/open.mjs",
    "./serve": "./src/app/console/serve.mjs",
    "./sdk-listener": "./src/features/monitor/sdk-listener.mjs",
    "./sdk-normalize": "./src/features/monitor/sdk-normalize.mjs",
    "./skills": "./src/features/skills/index.mjs",
    "./mcp": "./src/features/mcp/index.mjs",
    "./agent": "./src/features/agent/index.mjs",
    "./package.json": "./package.json"
  },
  "imports": {
    "#app/*": "./src/app/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*",
    "#ui/*": "./src/app/console/ui/*",
    "#extensions/*": "./extensions/*",
    "#scripts/*": "./scripts/*"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "CHECKLIST.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node src/features/monitor/demo.mjs",
    "serve": "node src/app/console/serve.mjs",
    "build": "vite build --config src/app/console/vite.config.mjs",
    "dev": "vite --config src/app/console/vite.config.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepublishOnly": "npm run build && npm test",
    "kusa:serve": "kusa serve",
    "cao:provider:install": "node src/features/kusa-cli/cao-provider/install.mjs",
    "cao:provider:uninstall": "node src/features/kusa-cli/cao-provider/install.mjs --uninstall"
  },
  "keywords": [
    "agent",
    "copilot",
    "cursor",
    "hooks",
    "observability",
    "kusa"
  ],
  "author": "Junjet Trasmonte",
  "license": "MIT",
  "dependencies": {
    "@node-saml/node-saml": "^5.2.0",
    "@opencode-ai/sdk": "^1.19.3",
    "openid-client": "^6.8.9",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.11",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=1.0.0",
    "opencode": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    },
    "opencode": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjettrasmonte/kusa.git"
  },
  "bugs": {
    "url": "https://github.com/junjettrasmonte/kusa/issues"
  },
  "homepage": "https://github.com/junjettrasmonte/kusa#readme",
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@opencode-ai/plugin": "^1.19.3"
  }
}
